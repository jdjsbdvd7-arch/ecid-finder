# --- Vercel site (and worker, SAME value) ---
# Random 32+ byte hex secret used to HMAC-sign result tokens (required in production; no default)
RESULT_HMAC_SECRET=replace_with_openssl_rand_hex_32
# Random 32+ byte hex secret for job tokens. MUST be identical on the Vercel site and the signing worker.
JOB_HMAC_SECRET=replace_with_openssl_rand_hex_32
# Vercel only: public HTTPS URL of the signing worker (no trailing slash). Unset = wizard shows "worker not connected".
WORKER_PUBLIC_URL=https://worker.example.com
# Vercel only: BLOB_READ_WRITE_TOKEN is added automatically when a Vercel Blob store is connected to the project.
# CRON_SECRET authorises the daily /api/blob-sweep cron (>=16 chars).
CRON_SECRET=replace_with_openssl_rand_hex_32
# Optional override when VERCEL_URL / request host is wrong
PUBLIC_BASE_URL=https://your-deployment.vercel.app

# --- Signing worker only (worker/server.js) ---
# HTTPS origin the iPhone can reach (used in OTA manifest/IPA URLs). iOS REQUIRES valid HTTPS.
# PUBLIC_BASE_URL=https://worker.example.com
# Comma-separated site origins allowed to call the worker from the browser
ALLOWED_ORIGINS=https://ecid-finder.vercel.app
# PORT=8787  HOST=127.0.0.1  TRUST_PROXY=1 (behind nginx/cloudflared)
# MAX_IPA_BYTES=629145600  MAX_CONCURRENT_SIGN=2  UPLOAD_TTL_MS=7200000  SIGNED_TTL_MS=10800000
# ECID_WORKER_DATA=/var/lib/ecid-worker   ECID_SIGNER_BIN=/path/to/ecid-signer
# ANISETTE_URL=https://your-own-anisette-v3-server   (default: https://ani.sidestore.io; isideload's own default ani.stikstore.app is Cloudflare-challenged from datacenters)
