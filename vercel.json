{
  "version": 2,
  "rewrites": [
    { "source": "/profile", "destination": "/api/profile" },
    { "source": "/retrieve", "destination": "/api/retrieve" }
  ],
  "headers": [
    {
      "source": "/api/profile",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/retrieve",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/profile",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/retrieve",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
